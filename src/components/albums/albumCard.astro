---
import { getFormattedDate } from "@utils/date";
import { Image } from "astro:assets";
import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
import { getSignedUrl } from "@aws-sdk/s3-request-presigner";

const { album } = Astro.props;

const s3 = new S3Client({
  region: import.meta.env.AWS_REGION || 'ap-southeast-2',
  credentials: {
    accessKeyId: import.meta.env.AWS_ACCESS_KEY_ID,
    secretAccessKey: import.meta.env.AWS_SECRET_ACCESS_KEY,
  },
});

const BUCKET_NAME = import.meta.env.S3_BUCKET_NAME;

// 1. Target the first image from your numerically sorted S3 list as the cover
const coverPhoto = album.data.photos[0];
let coverUrl = "";

if (coverPhoto) {
  const command = new GetObjectCommand({
    Bucket: BUCKET_NAME,
    Key: coverPhoto.id,
  });
  
  // Create short-lived thumbnail signatures (Expires in 1 hour)
  coverUrl = await getSignedUrl(s3, command, { expiresIn: 3600 });
}
---

<div class="flex flex-col">
    {/* album.id holds your markdown filename slug */}
    <a class="b1-no-underline" href={`/albums/${album.id}`}>
        <h1 class="text-center pb-0">{album.data.title}</h1>
        <p class="text-center pb-3">
            { getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" }) }
        </p>
        
        {coverUrl && (
            <Image 
                src={coverUrl} 
                class="w-full max-h-[70vh] pb-4 object-cover"
                alt={`Cover photo for ${album.data.title}`}
                width={1200}
                height={800}
                format="webp"
            />
        )}
    </a>
</div>
