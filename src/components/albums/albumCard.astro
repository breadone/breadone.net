---
import { getFormattedDate } from "@utils/date";
import { Image } from "astro:assets";
import { getSignedS3ObjectUrl, listAlbumObjectKeys } from "@utils/s3";

const { album } = Astro.props;

const [coverPhoto] = await listAlbumObjectKeys(album.id);
let coverUrl = "";

if (coverPhoto) {
  coverUrl = await getSignedS3ObjectUrl(coverPhoto);
}
---

<div class="flex flex-col">
  <a class="b1-no-underline" href={`/albums/${album.id}`}>
    <h1 class="text-center pb-0">{album.data.title}</h1>
    <p class="text-center pb-3">
      {getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" })}
    </p>

    {
      coverUrl && (
        <Image
          src={coverUrl}
          class="w-full max-h-[70vh] pb-4 object-cover"
          alt={`Cover photo for ${album.data.title}`}
          width={1200}
          height={800}
          format="webp"
        />
      )
    }
  </a>
</div>
