---
import Base from "@layout/Base";
import { getFormattedDate } from "@utils/date";
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";

// 1. If keeping prerender = false (SSR mode), use Astro.params.slug
export const prerender = false;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// 2. Fetch your S3-connected album from Astro Content Collections
const album = await getEntry("albums", slug);

// Redirect or render 404 if the album folder or markdown isn't found
if (!album) {
  return Astro.redirect('/404');
}

// 3. Define your S3 asset base URL (Astro handles optimization automatically)
const S3_BASE_URL = `https://${import.meta.env.S3_BUCKET_NAME}.s3.${import.meta.env.AWS_REGION || 'ap-southeast-2'}.amazonaws.com/`;

// Helper to construct full image paths
const images = album.data.photos.map(p => `${S3_BASE_URL}${p.id}`);
const ogImage = images.length > 0 ? images[0] : undefined;
---

<Base meta={{ title: album.data.title, description: album.data.remarks, ogImage }}>

    <div slot="sidebar">
        <h1>{album.data.title}</h1>
        <!-- Pass the date directly from your frontmatter/content configuration -->
        <p>{ getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" }) }</p>
        <p>{album.data.location}</p><br>

        {/* Set raw HTML safely if your content markdown/json contains HTML strings */}
        <Fragment set:html={album.data.remarks}/>
    </div>

    <div slot="content">
        { images.map(img =>  
            <Image 
                class="pb-2 w-full h-auto" 
                src={img} 
                alt={`${album.data.title} photograph`}
                width={1200}
                height={800}
                format="webp"
            /> 
        )}
    </div>
</Base>
