---
import Base from "@layout/Base";
import { getFormattedDate } from "@utils/date";
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { getSignedS3ObjectUrl, listAlbumObjectKeys } from "@utils/s3";

export const prerender = false;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const album = await getEntry("albums", slug);

if (!album) {
  return Astro.redirect("/404");
}

const photoKeys = await listAlbumObjectKeys(album.id);

const images = await Promise.all(
  photoKeys.map((photoKey) => getSignedS3ObjectUrl(photoKey)),
);

const ogImage = images.length > 0 ? images[0] : undefined;

const description = album.data.remarks ?? album.data.title;
const Content = (await render(album)).Content;
---

<Base meta={{ title: album.data.title, description, ogImage }}>
  <div slot="sidebar">
    <h1>{album.data.title}</h1>
    <p>
      {getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" })}
    </p>
    <p>{album.data.location}</p><br />

    {Content ? <Content /> : description && <p>{description}</p>}
  </div>

  <div slot="content">
    {
      images.map((img) => (
        <Image
          class="pb-2 w-full h-auto"
          src={img}
          alt={`${album.data.title} photograph`}
          width={1200}
          height={800}
          format="jpg"
        />
      ))
    }
  </div>
</Base>
