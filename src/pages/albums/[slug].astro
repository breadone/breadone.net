---
import Base from "@layout/Base";
import { getFormattedDate } from "@utils/date";
import { getEntry, render } from "astro:content";
import { listAlbumImageUrls } from "@utils/s3";

export const prerender = false;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const album = await getEntry("albums", slug);

if (!album) {
  return Astro.redirect("/404");
}

const images = await listAlbumImageUrls(album.id);
const ogImage = images[0];

const description = album.data.remarks ?? album.data.title;
const Content = (await render(album)).Content;
---

<Base meta={{ title: album.data.title, description, ogImage }}>
  <div slot="sidebar">
    <h1>{album.data.title}</h1>
    <p>
      {getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" })}
    </p>
    <p>{album.data.location}</p><br />

    <Content />
  </div>

  <div slot="content">
    {
      images.map((img) => (
        <button
          class="album-lightbox-trigger"
          type="button"
          data-lightbox-trigger
          aria-label={`View larger: ${album.data.title} photograph`}
        >
          <img
            class="pb-2 w-full h-auto"
            src={img}
            alt={`${album.data.title} photograph`}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))
    }

    <dialog
      class="album-lightbox"
      aria-label={`${album.data.title} photograph`}
    >
      <img class="album-lightbox-image" alt="" />
    </dialog>
  </div>
</Base>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>(".album-lightbox");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    ".album-lightbox-image",
  );

  const desktopViewport = window.matchMedia("(min-width: 48rem)");

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const trigger = event.target.closest<HTMLButtonElement>(
      "[data-lightbox-trigger]",
    );
    if (!trigger || !desktopViewport.matches || !lightbox || !lightboxImage)
      return;

    const image = trigger.querySelector<HTMLImageElement>("img");
    if (!image) return;

    lightboxImage.src = image.currentSrc || image.src;
    lightboxImage.alt = image.alt;
    lightbox.showModal();
  });

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });

  desktopViewport.addEventListener("change", (event) => {
    if (!event.matches && lightbox?.open) lightbox.close();
  });
</script>

<style>
  .album-lightbox-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
  }

  .album-lightbox {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  .album-lightbox[open] {
    display: grid;
    place-items: center;
    opacity: 1;
    transform: scale(1);
  }

  @starting-style {
    .album-lightbox[open] {
      opacity: 0;
      transform: scale(0.96);
    }

    .album-lightbox[open]::backdrop {
      opacity: 0;
    }
  }

  .album-lightbox::backdrop {
    background: rgb(0 0 0 / 68%);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition:
      opacity 5000ms ease,
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  .album-lightbox[open]::backdrop {
    opacity: 1;
  }

  .album-lightbox-image {
    display: block;
    max-width: 80vw;
    max-height: 80vh;
    object-fit: contain;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
  }

  @media (min-width: 48rem) {
    .album-lightbox-trigger {
      cursor: zoom-in;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .album-lightbox,
    .album-lightbox::backdrop {
      transition-duration: 0.01ms;
    }
  }
</style>
