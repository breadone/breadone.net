---
import Base from "@layout/Base";
import { getFormattedDate } from "@utils/date";
import { getEntry, render } from "astro:content";
import { listAlbumImageUrls } from "@utils/s3";

export const prerender = false;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const album = await getEntry("albums", slug);

if (!album) {
  return Astro.redirect("/404");
}

const images = await listAlbumImageUrls(album.id);
const ogImage = images[0];

const description = album.data.remarks ?? album.data.title;
const Content = (await render(album)).Content;
---

<Base meta={{ title: album.data.title, description, ogImage }}>
  <div slot="sidebar">
    <h1>{album.data.title}</h1>
    <p>
      {getFormattedDate(album.data.pubDate, { month: "long", year: "numeric" })}
    </p>
    <p>{album.data.location}</p><br />

    <Content />
  </div>

  <div slot="content">
    {
      images.map((img) => (
        <img
          class="pb-2 w-full h-auto"
          src={img}
          alt={`${album.data.title} photograph`}
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</Base>
